    def redeem(_shares: uint256, _receiver: address, _owner: address) -> uint256: nonpayable

# @dev Every _d_* / _collateral / _debt param on LlamaLend v2 is a DELTA.
interface ILendController:
    def create_loan(_collateral: uint256, _debt: uint256, _N: uint256, _for: address): nonpayable
    def borrow_more(_collateral: uint256, _debt: uint256, _for: address): nonpayable
    def add_collateral(_collateral: uint256, _for: address): nonpayable
    def remove_collateral(_collateral: uint256, _for: address): nonpayable
    def repay(_wallet_d_debt: uint256, _for: address): nonpayable
    def max_borrowable(_d_collateral: uint256, _N: uint256, _user: address) -> uint256: view
    def debt(_user: address) -> uint256: view
    def loan_exists(_user: address) -> bool: view
    def user_state(_user: address) -> uint256[4]: view
    def available_balance() -> uint256: view
    def borrow_cap() -> uint256: view
    def total_debt() -> uint256: view
    def loan_discount() -> uint256: view
    def extra_health(_user: address) -> uint256: view
    def amm() -> address: view
    def vault() -> address: view
    def remove_collateral_health_preview(_collateral: uint256, _for: address, _full: bool) -> int256: view

interface IAMM:
    def price_oracle() -> uint256: view
    def rate() -> uint256: view

interface ICurveStableSwap:
    def get_dy(i: int128, j: int128, dx: uint256) -> uint256: view
    def exchange(i: int128, j: int128, dx: uint256, min_dy: uint256) -> uint256: nonpayable

